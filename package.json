{
  "name": "linkpulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev --workspace=server\" \"npm run dev --workspace=web\"",
    "build": "npm run build --workspace=web && npm run build --workspace=server",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "express-rate-limit": "^8.7.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
